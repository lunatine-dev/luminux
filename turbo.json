{
    "$schema": "https://turborepo.dev/schema.json",
    "agentGuidance": false,
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".svelte-kit/**", "build/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "outputs": []
        },
        "format": {
            "cache": false
        }
    }
}
