{
    "$schema": "https://turborepo.dev/schema.json",
    "agentGuidance": false,
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".svelte-kit/**", "build/**"],
            "env": ["PUBLIC_*"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "outputs": []
        },
        "format": {
            "cache": false
        }
    },
    "globalEnv": [
        "NODE_ENV",
        "PUBLIC_API_URL",
        "PUBLIC_URL",
        "PUBLIC_ACCOUNT_URL",
        "PUBLIC_STATS_URL",
        "PUBLIC_STUDIO_URL"
    ]
}
