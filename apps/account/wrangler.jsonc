{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "luminux-account",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-10-01",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    }
}
