{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "luminux-stats",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-10-01",
    "observability": {
        "enabled": true
    },
    "workers_dev": false,
    "preview_urls": false,
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    }
}
